{
  "name": "command_palette",
  "version": "0.2.0",
  "description": "A command palette for Phoenix LiveView.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./priv/static/command_palette.mjs",
  "module": "./priv/static/command_palette.mjs",
  "types": "./priv/static/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./priv/static/types/index.d.ts",
      "import": "./priv/static/command_palette.mjs"
    },
    "./command_palette.css": "./priv/static/command_palette.css"
  },
  "files": [
    "priv/static",
    "assets/src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint assets",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
